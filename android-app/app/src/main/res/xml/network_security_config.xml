<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!--
        DOC SECURE portable development TLS configuration.

        Security:
        - Cleartext HTTP is blocked.
        - Normal Android/system certificate authorities remain trusted.
        - The DOC SECURE Development CA is trusted for HTTPS development servers.
        - Hostname/IP verification is still enforced by TLS, so each backend
          server certificate must contain the machine's actual IP/hostname in SAN.
    -->

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/docsecure_dev_ca" />
        </trust-anchors>
    </base-config>

</network-security-config>
